# Backend environment. Copy to backend/.env for local work; on Render set these in the
# service's Environment tab. PLACEHOLDERS ONLY: never commit real values.

# Port the API listens on (Render sets this itself).
PORT=4000

# Exact browser origin allowed by CORS. Local: http://localhost:3000.
# Production: the exact Vercel URL, e.g. https://your-app.vercel.app (no trailing slash).
# Several origins may be given, comma-separated.
FRONTEND_ORIGIN=http://localhost:3000

# Supabase pooler connection string for the callframe_api role (not the postgres role).
# Do NOT append ?sslmode=... : the API verifies TLS with the CA file below, and a sslmode
# in the URL can override it.
DATABASE_URL=postgresql://callframe_api.your-project-ref:replace-me@your-pooler-host:6543/postgres

# Path to the Supabase CA certificate (Dashboard > Database > Settings > SSL).
# Read by scripts/test_db.js. Relative paths resolve from backend/.
# The API itself currently reads certs/supabase-ca.crt (see README, "Database setup").
DATABASE_SSL_CA_PATH=certs/supabase-ca.crt

# Local-only escape hatch for a database WITHOUT TLS. Leave unset in production.
# DATABASE_SSL=false

# Gemini (backend only). The model has no default: pick one in Google AI Studio.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=replace-with-model-from-ai-studio

# Optional. When set, every /api request must send it as the x-access-code header.
# Leave blank for an open API. /health is always open.
APP_ACCESS_CODE=
