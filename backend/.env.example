# Local backend configuration. Copy this file to .env and fill in your own values.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL pooler connection string for the least-privileged callframe_api role.
# Do not add sslmode parameters; TLS verification is configured by the backend.
DATABASE_URL=postgresql://callframe_api.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Optional: set false only when deliberately connecting to a local database without TLS.
# DATABASE_SSL=false
# Default CA file is certs/supabase-ca.crt; TLS verification must remain enabled.

# Optional: when set, the frontend asks for this code and sends it as x-access-code.
# APP_ACCESS_CODE=replace-with-a-long-random-code

# Required only for the optional AI suggestion feature. Keep the key on the backend.
GEMINI_API_KEY=
GEMINI_MODEL=
